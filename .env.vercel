# ========================================
# KDXZHX 电商平台 Vercel 部署环境变量
# ========================================

# ----------------------------------------
# 基础服务配置
# ----------------------------------------
PORT=9999
NODE_ENV=production

# ----------------------------------------
# 支付宝支付配置 (选填，不配置则使用模拟支付)
# ----------------------------------------
# 支付宝加密密钥 (32字节十六进制，运行 node key-manager.js generate 生成)
ALIPAY_ENCRYPT_KEY=

# 加密后的支付宝配置 (使用 node key-manager.js encrypt 加密)
ALIPAY_APP_ID_ENCRYPTED=
ALIPAY_PRIVATE_KEY_ENCRYPTED=
ALIPAY_PUBLIC_KEY_ENCRYPTED=

# 支付宝网关 (沙箱环境: https://openapi.alipaydev.com/gateway.do, 正式环境: https://openapi.alipay.com/gateway.do)
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=https://kdxzhx.top/api/alipay/notify
ALIPAY_RETURN_URL=https://kdxzhx.top/payment-success

# ----------------------------------------
# 邮件通知配置 (选填)
# ----------------------------------------
# 邮件服务提供商: nodemailer | sendgrid | emailjs
EMAIL_PROVIDER=emailjs

# EmailJS 配置 (推荐)
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_OTP_TEMPLATE_ID=
EMAILJS_ORDER_TEMPLATE_ID=

# Nodemailer 配置 (备用)
EMAIL_USER=
EMAIL_PASS=

# SendGrid 配置 (备用)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ----------------------------------------
# 短信服务配置 (选填，当前主要使用邮箱)
# ----------------------------------------
SMS_PROVIDER=
TEXTBELT_KEY=textbelt
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM=
RONGLIAN_ACCOUNT_SID=
RONGLIAN_ACCOUNT_TOKEN=
RONGLIAN_APP_ID=
RONGLIAN_TEMPLATE_ID=
YUNPIAN_APIKEY=
YUNPIAN_TPL_ID=
SUBMAIL_APPID=
SUBMAIL_APPKEY=
SUBMAIL_PROJECT=
NETEASE_APP_KEY=
NETEASE_APP_SECRET=
NETEASE_TEMPLATE_ID=

# ----------------------------------------
# Firebase 配置 (可选)
# ----------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ----------------------------------------
# GitHub OAuth 配置 (可选)
# ----------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://kdxzhx.top/auth/callback/github

# ========================================
# 配置说明
# ========================================
#
# 1. 支付宝配置步骤:
#    a. 运行: node key-manager.js generate (生成 ALIPAY_ENCRYPT_KEY)
#    b. 访问 https://open.alipay.com 获取你的 APPID 和密钥
#    c. 运行: node key-manager.js encrypt (加密你的密钥)
#    d. 将加密结果填入上面的对应变量
#
# 2. EmailJS 配置:
#    a. 访问 https://www.emailjs.com 创建账号
#    b. 创建 Email Service 获取 SERVICE_ID
#    c. 创建 OTP 模板和订单通知模板
#    d. 在 Account -> API Keys 获取 Public Key 和 Private Key
#
# 3. Vercel 部署:
#    a. 在 Vercel Dashboard -> Settings -> Environment Variables
#    b. 逐个添加上面的环境变量
#    c. 重新部署项目
#
