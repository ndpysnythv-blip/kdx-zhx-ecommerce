{
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node@3",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/$1" }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "."
}
