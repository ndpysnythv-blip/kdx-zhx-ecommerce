{
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node@20.x",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/$1" }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "nodeVersion": "20.x"
}
