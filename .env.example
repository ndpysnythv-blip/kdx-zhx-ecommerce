# 支付宝支付配置
# ==========================

# 支付宝应用ID (必填)
# 从支付宝开放平台 https://open.alipay.com/ 获取
ALIPAY_APP_ID=

# 应用私钥 (必填)
# 使用支付宝密钥生成工具生成，格式为PKCS8
# 注意：不要包含 -----BEGIN PRIVATE KEY----- 和 -----END PRIVATE KEY-----
ALIPAY_PRIVATE_KEY=

# 支付宝公钥 (必填)
# 从支付宝开放平台获取，注意不是应用公钥
# 注意：不要包含 -----BEGIN PUBLIC KEY----- 和 -----END PUBLIC KEY-----
ALIPAY_PUBLIC_KEY=

# 支付宝网关地址 (可选)
# 沙箱环境: https://openapi.alipaydev.com/gateway.do
# 正式环境: https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do

# 支付结果异步通知地址 (可选)
# 需要公网可访问的URL，支付宝会向这个地址发送支付结果通知
# 例如: https://yourdomain.com/api/alipay/notify
ALIPAY_NOTIFY_URL=

# 支付结果同步返回地址 (可选)
# 用户支付成功后跳转的页面地址
# 例如: https://yourdomain.com/payment-success
ALIPAY_RETURN_URL=

# 其他配置
# ==========================

# 服务器端口
PORT=9999
