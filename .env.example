# ====================================================
# KDX丨ZHX电商平台 - 环境配置示例文件
# ====================================================
# 请将此文件复制为 .env 并填写您的实际配置
# ====================================================

# ====================================================
# 邮件服务选择（必选）
# ====================================================

# 选择邮件服务提供商：'sendgrid', 'nodemailer' 或 'emailjs'
# sendgrid: 推荐用于生产环境，稳定可靠（后端通知）
# nodemailer: 使用Gmail/QQ邮箱等SMTP服务（后端通知）
# emailjs: 使用EmailJS发送验证码和订单通知（推荐免费额度）
EMAIL_PROVIDER=sendgrid

# ====================================================
# EmailJS配置（可选，用于验证码和订单通知）
# ====================================================

# EmailJS Public Key
# 获取地址：https://dashboard.emailjs.com/account
EMAILJS_PUBLIC_KEY=mpcnF0Ueaq6qFJOId

# EmailJS Service ID
EMAILJS_SERVICE_ID=service_g4yw2de

# EmailJS Private Key（可选，用于高级功能）
EMAILJS_PRIVATE_KEY=51n2YyvWwTLmeeVfTKvpg

# EmailJS 一次性验证码模板 ID
EMAILJS_OTP_TEMPLATE_ID=template_z108m6x

# EmailJS 订单确认模板 ID
EMAILJS_ORDER_TEMPLATE_ID=template_0mpb8nd

# ====================================================
# SendGrid配置（推荐用于生产环境）
# ====================================================

# SendGrid API Key
# 获取地址：https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here

# SendGrid发件人邮箱（需要在SendGrid中验证此域名）
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ====================================================
# Nodemailer配置（可选，使用SMTP服务）
# ====================================================

# Gmail邮箱配置
# 注意：需要先开启Gmail两步验证，然后创建应用专用密码
# 操作指南：https://myaccount.google.com/apppasswords
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password-here

# QQ邮箱配置
# 注意：需要开启IMAP/SMTP服务并获取授权码
# EMAIL_USER=your-email@qq.com
# EMAIL_PASS=your-authorization-code-here

# ====================================================
# 短信服务配置（选择一个即可）
# ====================================================

# Textbelt（最简单，每天1条免费）
# SMS_PROVIDER=textbelt
# TEXTBELT_KEY=textbelt

# Twilio（国际短信，有免费额度）
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=your-twilio-phone

# Vonage (Nexmo)（国际短信）
# SMS_PROVIDER=vonage
# VONAGE_API_KEY=your-api-key
# VONAGE_API_SECRET=your-api-secret
# VONAGE_FROM=KDX

# Plivo（国际短信）
# SMS_PROVIDER=plivo
# PLIVO_AUTH_ID=your-auth-id
# PLIVO_AUTH_TOKEN=your-auth-token
# PLIVO_FROM=your-phone

# ====================================================
# 国内短信服务配置
# ====================================================

# 容联云通讯
# SMS_PROVIDER=ronglian
# RONGLIAN_ACCOUNT_SID=your-account-sid
# RONGLIAN_ACCOUNT_TOKEN=your-account-token
# RONGLIAN_APP_ID=your-app-id
# RONGLIAN_TEMPLATE_ID=1

# 云片网
# SMS_PROVIDER=yunpian
# YUNPIAN_APIKEY=your-apikey
# YUNPIAN_TPL_ID=your-template-id

# SUBMAIL
# SMS_PROVIDER=submail
# SUBMAIL_APPID=your-appid
# SUBMAIL_APPKEY=your-appkey
# SUBMAIL_PROJECT=your-project

# 网易云信
# SMS_PROVIDER=netease
# NETEASE_APP_KEY=your-app-key
# NETEASE_APP_SECRET=your-app-secret
# NETEASE_TEMPLATE_ID=your-template-id

# ====================================================
# 服务配置
# ====================================================

# 服务器端口（可选，默认9999）
# PORT=9999

# 环境模式（production/development）
# NODE_ENV=production

# 基础URL（生产环境填你的域名）
# BASE_URL=https://kdxzhx.top

# ====================================================
# 支付宝配置（可选，不配置则使用模拟支付）
# ====================================================

# 支付宝加密密钥（32字节十六进制，运行 node key-manager.js generate 生成）
# ALIPAY_ENCRYPT_KEY=

# 加密后的支付宝配置（使用 node key-manager.js encrypt 加密）
# ALIPAY_APP_ID_ENCRYPTED=
# ALIPAY_PRIVATE_KEY_ENCRYPTED=
# ALIPAY_PUBLIC_KEY_ENCRYPTED=

# 支付宝网关
# ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do

# 支付结果通知地址
# ALIPAY_NOTIFY_URL=https://kdxzhx.top/api/alipay/notify
# ALIPAY_RETURN_URL=https://kdxzhx.top/payment-success