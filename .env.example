# 支付宝配置示例文件
# 复制此文件为 .env 并填入你的真实配置

# ========== 支付宝配置 ==========
# 使用真实支付宝API的步骤：
# 1. 填入以下配置
# 2. 运行 node setup-alipay.js 加密密钥
# 3. 启动服务

# 支付宝应用 APPID
ALIPAY_APP_ID=

# 应用私钥（去掉首尾标记和换行）
ALIPAY_PRIVATE_KEY=

# 支付宝公钥（去掉首尾标记和换行）
ALIPAY_PUBLIC_KEY=

# 应用公钥（可选，去掉首尾标记和换行）
ALIPAY_APP_PUBLIC_KEY=

# 支付宝网关地址
# 沙箱环境: https://openapi.alipaydev.com/gateway.do
# 正式环境: https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do

# ========== 加密后的配置（由 setup-alipay.js 自动生成，不要手动修改） ==========
# ALIPAY_ENCRYPT_KEY=
# ALIPAY_APP_ID_ENCRYPTED=
# ALIPAY_PRIVATE_KEY_ENCRYPTED=
# ALIPAY_PUBLIC_KEY_ENCRYPTED=
# ALIPAY_APP_PUBLIC_KEY_ENCRYPTED=

# ========== 其他配置 ==========
# 服务器端口
PORT=9999
